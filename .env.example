# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Secret - CAMBIAR EN PRODUCCIÓN
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu-secreto-jwt-super-seguro-aqui-cambiar-en-produccion

# Contraseña por defecto para nuevos jugadores (solo para init-players)
DEFAULT_PASSWORD=cambiar123

# Orígenes permitidos para CORS (separados por comas)
# Para desarrollo local: http://localhost:3001
# Para producción en Render: https://tu-app.onrender.com
ALLOWED_ORIGINS=http://localhost:3001

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3001
